<Window x:Class="Paddock.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Title="Pad"
        Width="280" Height="220">
    <Window.Resources>
        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <EventSetter Event="DragStarted" Handler="Edge_DragStarted"/>
            <EventSetter Event="DragDelta" Handler="Edge_DragDelta"/>
            <EventSetter Event="DragCompleted" Handler="Edge_DragCompleted"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Hot" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="#B0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="8" Background="#B0202030"
            BorderBrush="#40FFFFFF" BorderThickness="1" AllowDrop="True"
            DragEnter="Pad_DragEnter" DragOver="Pad_DragOver" DragLeave="Pad_DragLeave" Drop="Pad_Drop">
        <Grid x:Name="Layout" AllowDrop="True">
            <!-- Row/column definitions are set in code (ArrangeHeader): the header sits on the side opposite a docked edge. -->
            <Border x:Name="Header" Background="#60000000" CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename..." Click="Rename_Click"/>
                        <MenuItem x:Name="RulesItem" Header="Edit rules..." Click="Rules_Click"/>
                        <MenuItem Header="Style..." Click="Style_Click"/>
                        <MenuItem Header="Icon size">
                            <MenuItem Header="Small" Tag="24" Click="IconSize_Click"/>
                            <MenuItem Header="Medium" Tag="32" Click="IconSize_Click"/>
                            <MenuItem Header="Large" Tag="48" Click="IconSize_Click"/>
                        </MenuItem>
                        <MenuItem Header="Dock to screen edge">
                            <MenuItem Header="Off (free floating)" Tag="None" Click="Dock_Click"/>
                            <MenuItem Header="Left" Tag="Left" Click="Dock_Click"/>
                            <MenuItem Header="Right" Tag="Right" Click="Dock_Click"/>
                            <MenuItem Header="Top" Tag="Top" Click="Dock_Click"/>
                            <MenuItem Header="Bottom" Tag="Bottom" Click="Dock_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="ArchiveSetItem" Header="Auto-archive old files..." Click="ArchiveSet_Click"/>
                        <MenuItem x:Name="ArchiveNowItem" Header="Archive old files now" Click="ArchiveNow_Click"/>
                        <MenuItem x:Name="AddAppItem" Header="Add app..." Click="AddApp_Click"/>
                        <MenuItem x:Name="ActionSetItem" Header="Rule action (move/copy)..." Click="ActionSet_Click"/>
                        <MenuItem x:Name="ActionRunItem" Header="Preview and run rule action" Click="ActionRun_Click"/>
                        <MenuItem x:Name="ActionAutoItem" Header="Run rule action automatically" IsCheckable="True" Click="ActionAuto_Click"/>
                        <MenuItem x:Name="DefaultItem" Header="Default pad for unsorted files"
                                  IsCheckable="True" Click="Default_Click"/>
                        <MenuItem x:Name="NoteOpenItem" Header="Open note in its editor" Visibility="Collapsed" Click="NoteOpen_Click"/>
                        <MenuItem x:Name="LinksItem" Header="Edit links..." Visibility="Collapsed" Click="Links_Click"/>
                        <MenuItem x:Name="ChameleonItem" Header="Chameleon (icons fade until hover)" IsCheckable="True" Click="Chameleon_Click"/>
                        <MenuItem x:Name="WallpaperItem" Header="Match wallpaper colour" IsCheckable="True" Click="Wallpaper_Click"/>
                        <MenuItem Header="Pad tools">
                            <MenuItem x:Name="OpenAllItem" Header="Open all items" Click="OpenAll_Click"/>
                            <MenuItem x:Name="ReportItem" Header="Report duplicates and stale files..." Click="Report_Click"/>
                            <MenuItem Header="Hotkey..." Click="Hotkey_Click"/>
                            <MenuItem x:Name="LockItem" Header="Lock position and size" IsCheckable="True" Click="Lock_Click"/>
                            <MenuItem x:Name="SingleClickItem" Header="Open with a single click" IsCheckable="True" Click="SingleClick_Click"/>
                            <MenuItem x:Name="SortUseItem" Header="Most-used items first" IsCheckable="True" Click="SortUse_Click"/>
                            <MenuItem x:Name="BlurItem" Header="Blur behind the pad" IsCheckable="True" Click="Blur_Click"/>
                            <MenuItem Header="Auto-hide when idle..." Click="AutoHide_Click"/>
                            <MenuItem Header="Clear selection" Click="ClearSelection_Click"/>
                            <MenuItem Header="Export this pad..." Click="Export_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="SplitItem" Header="Split this tab into its own pad"
                                  Visibility="Collapsed" Click="Split_Click"/>
                        <MenuItem Header="Roll up / down" Click="RollUp_Click"/>
                        <MenuItem x:Name="ExcludeItem" Header="Exclude from quick-hide"
                                  IsCheckable="True" Click="Exclude_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete pad" Click="Delete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid x:Name="HeaderInner">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="4,0" Visibility="Collapsed"/>
                    <TextBox x:Name="SearchBox" Visibility="Collapsed" Margin="4,3,2,3" Padding="4,0"
                             VerticalContentAlignment="Center" FontSize="12"
                             Background="#40FFFFFF" Foreground="White" CaretBrush="White" BorderThickness="0"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             LostKeyboardFocus="SearchBox_LostFocus"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OpenAllButton" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Visibility="Collapsed"
                                   Foreground="#C0FFFFFF" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0"
                                   Cursor="Hand" ToolTip="Open all (apps, links and the folder)" Background="Transparent"
                                   MouseLeftButtonDown="OpenAllButton_MouseLeftButtonDown"/>
                        <TextBlock x:Name="SearchButton" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#C0FFFFFF" FontSize="12" VerticalAlignment="Center" Margin="4,0,9,0"
                                   Cursor="Hand" ToolTip="Search this pad" Background="Transparent"
                                   MouseLeftButtonDown="SearchButton_MouseLeftButtonDown"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="4" AllowDrop="True">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Margin="2" CornerRadius="6" Background="Transparent">
                                <Border.Triggers>
                                    <!-- Click: the icon dips and springs back. -->
                                    <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                                 To="0.82" Duration="0:0:0.08" AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                                 To="0.82" Duration="0:0:0.08" AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity"
                                                                 From="0.55" To="0" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Border x:Name="Flash" CornerRadius="6" Background="White" Opacity="0" IsHitTestVisible="False"/>
                                    <StackPanel Width="{Binding TileWidth}" Background="Transparent"
                                                MouseLeftButtonDown="Item_MouseLeftButtonDown"
                                                MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                                MouseMove="Item_MouseMove"
                                                ToolTip="{Binding Tip}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Unpin from this pad (back to rules)" Click="Unpin_Click"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Image x:Name="Ico" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                               Margin="0,4,0,2" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform><ScaleTransform x:Name="IconScale"/></Image.RenderTransform>
                                        </Image>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Ctrl-click selection. -->
                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#55FFFFFF"/>
                                </DataTrigger>
                                <!-- Hover: a soft backdrop plate and a glow that follows the icon's own outline. -->
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="#33FFFFFF"/>
                                    <Setter TargetName="Ico" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBox x:Name="NoteBox" Grid.Row="1" Visibility="Collapsed" Margin="4" Padding="4"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#30000000" Foreground="White" CaretBrush="White" BorderThickness="0" FontSize="13"
                     TextChanged="NoteBox_TextChanged" LostKeyboardFocus="NoteBox_LostFocus"/>

            <!-- Resize handles: every side and corner. Spans the whole pad (ArrangeHeader sets the span); a side lights up under the mouse. -->
            <Grid x:Name="Grip" Grid.RowSpan="2" Grid.ColumnSpan="2">
                <Thumb Tag="T" Style="{StaticResource EdgeThumb}" Cursor="SizeNS" Height="6" VerticalAlignment="Top" Margin="14,0"/>
                <Thumb Tag="B" Style="{StaticResource EdgeThumb}" Cursor="SizeNS" Height="6" VerticalAlignment="Bottom" Margin="14,0"/>
                <Thumb Tag="L" Style="{StaticResource EdgeThumb}" Cursor="SizeWE" Width="6" HorizontalAlignment="Left" Margin="0,14"/>
                <Thumb Tag="R" Style="{StaticResource EdgeThumb}" Cursor="SizeWE" Width="6" HorizontalAlignment="Right" Margin="0,14"/>
                <Thumb Tag="TL" Style="{StaticResource EdgeThumb}" Cursor="SizeNWSE" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Thumb Tag="TR" Style="{StaticResource EdgeThumb}" Cursor="SizeNESW" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                <Thumb Tag="BL" Style="{StaticResource EdgeThumb}" Cursor="SizeNESW" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                <Thumb Tag="BR" Style="{StaticResource EdgeThumb}" Cursor="SizeNWSE" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Background="#50FFFFFF"/>
            </Grid>
        </Grid>
    </Border>
</Window>
